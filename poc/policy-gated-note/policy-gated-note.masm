#! Policy-gated private payment note — Miden 0.15 PoC
#!
#! Storage layout:
#! [0] recipient account suffix
#! [1] recipient account prefix
#! [2] recipient_allowed (1 = pass)
#! [3] asset_allowed (1 = pass)
#! [4] jurisdiction_allowed (1 = pass)
#!
#! IMPORTANT: the three policy flags are PoC inputs. A production design must
#! derive/verify them cryptographically or from an authorized account/policy
#! component; sender-supplied booleans alone are not compliance enforcement.

use.miden::protocol::account
use.miden::protocol::note
use.miden::standards::wallets::basic

@note_script
pub proc main
    # Read the five policy/recipient fields from active-note storage.
    exec.note::get_inputs

    # Expected input count is five.
    dup.0 push.5 assert_eq

    # Drop count and leave the five inputs available to the script.
    drop

    # PoC policy gate: each flag must equal 1.
    # Stack ordering is intentionally documented/tested before testnet use.
    # This file is a protocol-level scaffold, not yet claimed as deployed.
    dup.0 push.1 assert_eq
    dup.1 push.1 assert_eq
    dup.2 push.1 assert_eq

    # Recipient binding should follow the standard P2ID account-id comparison
    # and asset movement flow. We keep that final wiring explicit as the next
    # testnet milestone rather than pretending this scaffold is production-ready.

    # Move the note assets only after all policy assertions pass.
    call.basic::receive_asset
end
